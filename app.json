{
  "stack": "heroku-22",
  "name": "Fantasy Baseball Chat Bot",
  "description": "ESPN Fantasy Baseball GroupMe, Slack, and Discord Chat Bot.",
  "keywords": [
    "fantasy baseball",
    "espn",
    "groupme",
    "slack",
    "discord",
    "chat bot",
    "mlb"
  ],
  "env": {
    "BOT_ID": {
      "description": "GroupMe Bot ID",
      "value": "1",
      "required": false
    },
    "SLACK_WEBHOOK_URL": {
      "description": "Slack Webhook URL",
      "value": "1",
      "required": false
    },
    "DISCORD_WEBHOOK_URL": {
      "description": "Discord Webhook URL",
      "value": "1",
      "required": false
    },
    "LEAGUE_ID": {
      "description": "ESPN Fantasy Baseball League ID",
      "value": "1"
    },
    "LEAGUE_YEAR": {
      "description": "ESPN League Year",
      "value": "2026",
      "required": false
    },
    "TIMEZONE": {
      "description": "League timezone for sending messages",
      "value": "America/New_York",
      "required": false
    },
    "START_DATE": {
      "description": "Season Start Date",
      "value": "2026-03-26",
      "required": false
    },
    "END_DATE": {
      "description": "Season End Date",
      "value": "2026-10-15",
      "required": false
    },
    "INIT_MSG": {
      "description": "Bot Init Message",
      "value": "Fantasy Baseball Bot is live! Good luck this season."
    }
  }
}
